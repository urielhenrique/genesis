# Detecta automaticamente arquivos texto
* text=auto

# Arquivos que sempre serão armazenados com LF
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
*.sql text eol=lf
*.dbml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sh text eol=lf

# Arquivos Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Arquivos binários
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.zip binary